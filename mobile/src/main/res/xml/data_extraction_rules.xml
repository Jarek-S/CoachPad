<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The encrypted API key: its Keystore key stays on this phone, so a restored copy is useless -->
    <cloud-backup>
        <exclude domain="sharedpref" path="stt.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="stt.xml" />
    </device-transfer>
</data-extraction-rules>
